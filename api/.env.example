# Copy to api/.env and fill in.
GROQ_API_KEY=
# Vision model used to read diagrams (must support images + JSON mode)
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Text model used by the learning companion
GROQ_CHAT_MODEL=openai/gpt-oss-120b
# 1 = fall back to built-in demo content if the AI call fails
DEMO_MODE=1
# Voice used when the browser has no built-in voices (e.g. Chrome on Linux).
# Accept the model terms once at console.groq.com. Voices: autumn diana hannah austin daniel troy
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah

# YarnGPT: Nigerian voices, and listening in Yoruba, Igbo, Hausa or Pidgin (translated automatically).
# Get a key at https://yarngpt.ai. Every call spends credits; audio is cached by the API.
YARNGPT_API_KEY=
# Optional fixed voice id (see GET https://api.yarngpt.ai/api/v1/voices); otherwise picked per language
YARNGPT_VOICE=
